---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { contact } from '../data/contact';
interface Props { title?: string; description?: string; }
const { title, description = 'Selected engineering, computational modeling and quantitative research projects.' } = Astro.props;
const pageTitle = title ? title + ' — Jesse Koeppel' : 'Jesse Koeppel — Engineering & Research';
const path = Astro.url.pathname;
const nav = [{href:'/#work',label:'Work'},{href:'/about/',label:'About'},{href:'/resume/',label:'Résumé'},{href:'/contact/',label:'Contact'}];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#f2f4f6" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={new URL(path, Astro.site)} />
<title>{pageTitle}</title>
</head>
<body class:list={[path==='/'&&'home-page',path.startsWith('/projects/')&&'project-page']}>
<a class="skip" href="#main">Skip to content</a>
<div class="shell">
<header class="site-header">
<a class="wordmark" href="/">JESSE KOEPPEL<span>.</span></a>
<nav aria-label="Primary">
{nav.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
<a href={contact.github}>GitHub <span aria-hidden="true">↗</span></a>
<a href={contact.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
</nav>
</header>
<main id="main"><slot /></main>
<footer class="site-footer"><span>© {new Date().getFullYear()} Jesse Koeppel</span><div class="footer-links"><a href="/contact/">Contact</a><a href={contact.github}>GitHub <span aria-hidden="true">↗</span></a><a href={contact.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></div></footer>
</div>
</body>
</html>
