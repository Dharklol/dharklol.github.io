---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Selected engineering, computational modeling and quantitative research projects.' } = Astro.props;
const pageTitle = title ? title + ' — Jesse Steel' : 'Jesse Steel — Engineering & Research';
const path = Astro.url.pathname;
const nav = [{href:'/#work',label:'Work'},{href:'/about/',label:'About'}];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#f2f4f6" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={new URL(path, Astro.site)} />
<title>{pageTitle}</title>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="shell">
<header class="site-header">
<a class="wordmark" href="/">JESSE STEEL<span>.</span></a>
<nav aria-label="Primary">
{nav.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
<a href="https://github.com/Dharklol">GitHub <span aria-hidden="true">↗</span></a>
</nav>
</header>
<main id="main"><slot /></main>
<footer class="site-footer"><span>© {new Date().getFullYear()} Jesse Steel</span><a href="https://github.com/Dharklol">GitHub ↗</a></footer>
</div>
</body>
</html>
