---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<Base>
<section class="hero" aria-labelledby="hero-title">
<p class="eyebrow">ENGINEERING / COMPUTATION / RESEARCH</p>
<h1 id="hero-title">Building and modeling<br class="desktop-break"/> complex systems.</h1>
<div class="hero-rule"></div>
<p class="hero-copy">Mechanical engineering, computational modeling, quantitative research, and the infrastructure connecting them.</p>
<div class="hero-actions"><a class="text-link" href="#work">Selected work <span aria-hidden="true">↓</span></a><a class="text-link secondary-link" href="/resume/">Résumé <span aria-hidden="true">↗</span></a><a class="text-link secondary-link" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a></div>
</section>
<section id="work" class="work-section" aria-labelledby="work-title">
<div class="section-heading"><h2 id="work-title">Selected work</h2><span class="eyebrow">01 — 03</span></div>
<div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div>
</section>
<section class="closing"><p class="eyebrow">ABOUT</p><h2>Engineering across disciplines.</h2><p>My interests sit at the intersection of physical systems, mathematical models and the software used to understand them.</p><a class="text-link" href="/about/">More about me ↗</a></section>
</Base>
