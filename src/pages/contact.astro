---
import Base from '../layouts/Base.astro';
import { contact } from '../data/contact';
const channels = [
  {label:'01 / EMAIL', title:'Email', value:contact.email, href:'mailto:'+contact.email, detail:'For professional inquiries, opportunities, collaborations, and technical discussions.'},
  {label:'02 / PROFESSIONAL NETWORK', title:'LinkedIn', value:'Connect on LinkedIn', href:contact.linkedin, detail:'For professional networking, career conversations, and experience.'},
  {label:'03 / CODE & PROJECTS', title:'GitHub', value:'github.com/Dharklol', href:contact.github, detail:'For source code, project documentation, and repository-specific discussions.'},
];
---
<Base title="Contact" description="Get in touch for engineering, research, professional opportunities, and technical collaborations.">
  <section class="contact-page" aria-labelledby="contact-heading">
    <header class="contact-intro">
      <p class="eyebrow">CONTACT / 01</p>
      <h1 id="contact-heading">Let's get in touch.</h1>
      <div class="hero-rule"></div>
      <p class="lede">I’m interested in conversations about engineering, computational mechanics, research, and the systems that connect them.</p>
    </header>
    <div class="contact-grid">
      <section class="contact-channels" aria-label="Contact channels">
        {channels.map(channel=><article class="contact-channel">
          <p class="eyebrow">{channel.label}</p>
          <h2>{channel.title}</h2>
          <p>{channel.detail}</p>
          <a class="contact-link" href={channel.href}>{channel.value}<span aria-hidden="true">↗</span></a>
        </article>)}
      </section>
      <aside class="contact-aside" aria-label="Areas of interest">
        <p class="eyebrow">AREAS OF INTEREST</p>
        <h2>Where we might connect.</h2>
        <ul><li>Mechanical engineering and vehicle dynamics</li><li>Scientific computing and numerical modeling</li><li>Quantitative research and financial systems</li><li>Research and software collaboration</li></ul>
        <p>For project-specific questions, a link to the relevant work or a short description of your inquiry is helpful.</p>
        <a class="text-link" href="/#work">Explore selected work <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>
</Base>
