---
import Base from '../../layouts/Base.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import { fsaePhotos } from '../../data/project-visuals';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project=>({params:{id:project.id},props:{project}}));
}
const {project} = Astro.props;
const {Content, headings} = await render(project);
const sections = headings.filter(h=>h.depth===2);
const {title,summary,discipline,status,tags,kind,order} = project.data;
---
<Base title={title} description={summary}>
<article class="case-study">
<a class="text-link" href="/#work">← Selected work</a>
<p class="eyebrow case-kicker">{String(order).padStart(2,'0')} / {discipline}</p>
<h1>{title}</h1>
<p class="lede">{summary}</p>
<div class="case-meta"><span>{status}</span><span>{tags.join(' / ')}</span></div>
<div class="figure-wrap case-figure"><ProjectHero kind={kind}/></div>
{sections.length > 4 && <nav class="article-contents" aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p><ol>{sections.map(section=><li><a href={'#'+section.slug}>{section.text}</a></li>)}</ol></nav>}
<div class="prose"><Content/></div>
{kind==='fsae' && fsaePhotos.length>0 && <section class="photo-archive" aria-labelledby="photo-title"><h2 id="photo-title">Workshop and competition</h2><div class="photo-grid">{fsaePhotos.filter(p=>['steering-build.jpg','suspension-failure.jpg'].includes(p.file)).map(p=><figure><a href={p.src!}><img src={p.src!} alt={p.alt} loading="lazy"/></a><figcaption>{p.label}</figcaption></figure>)}</div></section>}
</article>
</Base>
